# ═══════════════════════════════════════════════════════════════════
# BOOKIIFY — SERVER ENVIRONMENT VARIABLES
# Copy this file to .env and fill in the values.
# Lines marked [REQUIRED] must be set or the server will refuse to start.
# Lines marked [OPTIONAL] have safe defaults and can be left out.
# Lines marked [FEATURE FLAG] enable specific features when set to true.
# ═══════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────
# 1. CORE — REQUIRED
# ───────────────────────────────────────────────────────────────────
NODE_ENV=development                        # [REQUIRED] production | development
PORT=5000                                   # [OPTIONAL] default: 5000
CLIENT_URL=http://localhost:5173            # [REQUIRED] frontend URL (Vercel URL in prod)

# ───────────────────────────────────────────────────────────────────
# 2. DATABASE & CACHE — REQUIRED
# ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://...                 # [REQUIRED] MongoDB Atlas connection string
REDIS_URL=rediss://...                      # [REQUIRED] Upstash Redis URL

# ───────────────────────────────────────────────────────────────────
# 3. AUTH SECRETS — REQUIRED
# ───────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your-super-secret-key     # [REQUIRED] min 32 chars random string
JWT_REFRESH_SECRET=another-secret-key       # [OPTIONAL] falls back to ACCESS_SECRET if missing

# ───────────────────────────────────────────────────────────────────
# 4. EMAIL — REQUIRED (Brevo SMTP)
# ───────────────────────────────────────────────────────────────────
BREVO_SMTP_USER=your@brevo-account.com      # [REQUIRED]
BREVO_SMTP_KEY=xsmtp-...                    # [REQUIRED] Brevo API key
BREVO_FROM_EMAIL=noreply@bookiify.com       # [OPTIONAL] default sender address
BREVO_FROM_NAME=Bookiify                    # [OPTIONAL] default sender name

# ───────────────────────────────────────────────────────────────────
# 5. FILE UPLOADS — REQUIRED (Cloudinary)
# ───────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name       # [REQUIRED]
CLOUDINARY_API_KEY=123456789012345          # [REQUIRED]
CLOUDINARY_API_SECRET=your-api-secret       # [REQUIRED]

# ───────────────────────────────────────────────────────────────────
# 6. BOOKING REMINDERS
# ───────────────────────────────────────────────────────────────────
ENABLE_REMINDERS=true                       # [FEATURE FLAG] set false to disable cron reminders

# ───────────────────────────────────────────────────────────────────
# 7. WHATSAPP — Meta Business Cloud API
#    Dashboard: https://developers.facebook.com/apps
#    Steps:
#      1. Create a Meta App → WhatsApp → Business
#      2. Get a permanent access token (System User token recommended)
#      3. Note your Phone Number ID from the API setup page
#      4. Add test numbers in the Sandbox first
#      5. Set WHATSAPP_ENABLED=true when ready
# ───────────────────────────────────────────────────────────────────
WHATSAPP_ENABLED=false                      # [FEATURE FLAG] false = all WA messages silently skipped
WHATSAPP_API_TOKEN=EAAxxxxxx...             # Meta Graph API permanent access token
WHATSAPP_PHONE_ID=123456789012345          # WhatsApp Business phone number ID

# ───────────────────────────────────────────────────────────────────
# 8. SMS — Future Tunisian gateway (InTouch, Ooredoo, etc.)
# ───────────────────────────────────────────────────────────────────
SMS_ENABLED=false                           # [FEATURE FLAG]
SMS_PROVIDER=disabled                       # twilio | vonage | local | disabled

# Twilio (international)
TWILIO_SID=ACxxxxxxxxxx
TWILIO_AUTH=your-auth-token
TWILIO_FROM=+1234567890

# ───────────────────────────────────────────────────────────────────
# 9. PAYMENTS
#    Stripe is wired but does NOT work in Tunisia.
#    Set DEPOSIT_ENABLED=true only after connecting a Tunisian gateway.
#    Options: Konnect (konnect.network), Flouci, Paymee, D17
# ───────────────────────────────────────────────────────────────────
DEPOSIT_ENABLED=false                       # [FEATURE FLAG] enables deposit flow on bookings

# Stripe (international — not usable in TN without intermediary)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Konnect (Tunisia — preferred)
# KONNECT_API_KEY=
# KONNECT_WALLET_ID=
# KONNECT_BASE_URL=https://api.konnect.network/api/v2

# Flouci (Tunisia)
# FLOUCI_APP_TOKEN=
# FLOUCI_APP_SECRET=

# ───────────────────────────────────────────────────────────────────
# 10. RENDER.COM DEPLOYMENT
# ───────────────────────────────────────────────────────────────────
RENDER_EXTERNAL_URL=https://your-app.onrender.com   # [OPTIONAL] auto-set by Render
